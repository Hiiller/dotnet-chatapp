<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			  xmlns:reactive="clr-namespace:ReactiveUI;assembly=ReactiveUI"
			  xmlns:c="clr-namespace:ChatApp.Client.Controls;assembly=ChatApp.Client"
			  xmlns:models="clr-namespace:ChatApp.Client.Models;assembly=ChatApp.Client"
			  xmlns:viewModels="clr-namespace:ChatApp.Client.ViewModels"
			  xmlns:dtOs="clr-namespace:ChatApp.Client.DTOs"
			  Background="{DynamicResource ChatBackground}"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ChatApp.Client.Views.ChatView"
             x:DataType="viewModels:ChatViewModel"
             x:CompileBindings="True">

	
	
	<UserControl.DataTemplates>

		<!-- 姣忔潯娑堟伅閫氳繃ChatBubble灞曠ず锛氭枃鏈垨鍥剧墖闄勪欢 -->
			<DataTemplate DataType="dtOs:MessageDto">
				<!-- 澶村儚鍦ㄦ皵娉″渚э細鍒嗗埆涓烘帴鏀惰€咃紙宸︿晶澶村儚锛変笌鍙戦€佽€咃紙鍙充晶澶村儚锛夊竷灞€ -->
				<StackPanel>
					<!-- Receiver锛氬乏渚уご鍍忥紝鍙充晶姘旀场 -->
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
					            IsVisible="{Binding ChatRoleType, Converter={StaticResource RoleToBooleanConverter}, ConverterParameter=Receiver}">
                        <!-- 澶村儚锛?2x32銆佸渾瑙?6锛涚粺涓€钃濊壊鍦嗗簳锛涙棤澶村儚鏄剧ず棣栧瓧姣?-->
                        <Border Width="32" Height="32" CornerRadius="16" ClipToBounds="True" Margin="0,0,8,0" Background="#2D8EFF">
                            <Grid>
                                <Image Source="{Binding senderAvatar}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding senderAvatar, Converter={StaticResource NullToBooleanConverter}}"/>
                                <Border Background="#2D8EFF"
                                        IsVisible="{Binding senderAvatar, Converter={StaticResource NullToBooleanInverseConverter}}">
                                    <TextBlock Text="{Binding SenderDisplay, Converter={StaticResource StringToInitialsConverter}}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
						<c:ChatBubble  IsRead="{Binding IsRead}" Role="{Binding ChatRoleType}">
							<StackPanel>
								<TextBlock Text="{Binding SenderDisplay}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource SystemBaseHighColor}"/>
								<Image Source="{Binding attachmentImage}" Width="220" MaxHeight="240" Stretch="Uniform"
								       IsVisible="{Binding attachmentImage, Converter={StaticResource NullToBooleanConverter}}"/>
								<TextBlock Text="{Binding content}" TextWrapping="Wrap" />
							</StackPanel>
						</c:ChatBubble>
					</StackPanel>

					<!-- Sender锛氬彸渚уご鍍忥紝宸︿晶姘旀场锛堟暣浣撳彸瀵归綈锛?-->
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
					            IsVisible="{Binding ChatRoleType, Converter={StaticResource RoleToBooleanConverter}, ConverterParameter=Sender}">
						<c:ChatBubble  IsRead="{Binding IsRead}" Role="{Binding ChatRoleType}">
							<StackPanel>
								<TextBlock Text="{Binding SenderDisplay}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource SystemBaseHighColor}"/>
								<Image Source="{Binding attachmentImage}" Width="220" MaxHeight="240" Stretch="Uniform"
								       IsVisible="{Binding attachmentImage, Converter={StaticResource NullToBooleanConverter}}"/>
								<TextBlock Text="{Binding content}" TextWrapping="Wrap" />
							</StackPanel>
						</c:ChatBubble>
                        <!-- 澶村儚锛?2x32銆佸渾瑙?6锛涚粺涓€钃濊壊鍦嗗簳锛涙棤澶村儚鏄剧ず棣栧瓧姣?-->
                        <Border Width="32" Height="32" CornerRadius="16" ClipToBounds="True" Margin="8,0,0,0" Background="#2D8EFF">
                            <Grid>
                                <Image Source="{Binding senderAvatar}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding senderAvatar, Converter={StaticResource NullToBooleanConverter}}"/>
                                <Border Background="#2D8EFF"
                                        IsVisible="{Binding senderAvatar, Converter={StaticResource NullToBooleanInverseConverter}}">
                                    <TextBlock Text="{Binding SenderDisplay, Converter={StaticResource StringToInitialsConverter}}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
					</StackPanel>
				</StackPanel>
			</DataTemplate>

		<!-- 鐢ㄦ埛杩炴帴鏃剁殑娑堟伅锛屾樉绀轰竴鏉℃í绾垮拰涓€鏉＄豢鑹茬殑鏂囨湰淇℃伅锛岃〃绀烘煇鐢ㄦ埛涓婄嚎 -->
		<DataTemplate DataType="models:UserConnectedMessage">
			<Grid ColumnDefinitions="*, Auto, *">
				<Border Height="1" Background="Gray" Opacity="0.5" HorizontalAlignment="Stretch" Margin="20"/>
				<TextBlock Text="{Binding Content}" Foreground="Green" Opacity="0.7" FontSize="10" Grid.Column="1" HorizontalAlignment="Center"/>
				<Border Height="1" Background="Gray" Grid.Column="2" Opacity="0.5" HorizontalAlignment="Stretch" Margin="20,5"/>
			</Grid>
		</DataTemplate>

		<!-- 鐢ㄦ埛鏂紑杩炴帴鏃剁殑娑堟伅锛屾樉绀轰竴鏉℃í绾垮拰涓€鏉＄孩鑹茬殑鏂囨湰淇℃伅锛岃〃绀烘煇鐢ㄦ埛涓嬬嚎 -->
		<DataTemplate DataType="models:UserDisconnectedMessage">
			<Grid ColumnDefinitions="*, Auto, *">
				<Border Height="1" Background="Gray" Opacity="0.3" HorizontalAlignment="Stretch" Margin="20"/>
				<TextBlock Text="{Binding Content}" Foreground="Red" Opacity="0.7" Grid.Column="1" FontSize="10" HorizontalAlignment="Center"/>
				<Border Height="1" Background="Gray" Grid.Column="2" Opacity="0.3" HorizontalAlignment="Stretch" Margin="20,5"/>
			</Grid>
		</DataTemplate>

	</UserControl.DataTemplates>

	<UserControl.Resources>
		<!-- 瀹氫箟鎸夐挳榛樿鐘舵€佷笅鐨勮儗鏅壊 -->
		<SolidColorBrush x:Key="NormalButtonBrush" Color="#0EA5E9"/>
		<!-- 瀹氫箟榧犳爣鎮仠鏃剁殑鑳屾櫙鑹?-->
		<SolidColorBrush x:Key="HoverButtonBrush" Color="#191919"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- 榛樿鎸夐挳鑳屾櫙鑹?-->
		<Style Selector="Button">
			<Setter Property="Background" Value="{StaticResource NormalButtonBrush}"/>
		</Style>
		<!-- 榧犳爣鎮仠鏃舵敼鍙樻寜閽儗鏅壊 -->
		<Style Selector="Button:IsPointerOver">
			<Setter Property="Background" Value="{StaticResource HoverButtonBrush}"/>
		</Style>
	</UserControl.Styles>
	
	
	<!-- 涓诲竷灞€ Grid -->
	<Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="*, Auto">
		
		<!-- 褰撳墠鑱婂ぉ瀵硅薄鐨勫悕瀛?-->
	<TextBlock Grid.Row="0" Grid.ColumnSpan="2"
		           Text="{Binding OppositeUserName}" 
		           FontSize="25" 
		           FontFamily="{DynamicResource AppFontFamily}"
		           HorizontalAlignment="Center" 
		           VerticalAlignment="Center"
		           Margin="10,10,10,10" />
		
		<!-- 杩斿洖鎸夐挳 -->
		<Button Grid.Row="0" Grid.Column="0" Command="{Binding ReturnToChatListCommand}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10">
			<Button.Content>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Image Source="avares://ChatApp.Client/Assets/return.png" Width="20" Height="20" Margin="0,0,5,0"/>
					<TextBlock Text="Back" VerticalAlignment="Center"/>
				</StackPanel>
			</Button.Content>
		</Button>
		
		<!-- 缇よ鎯呮寜閽?-->
		<Button Grid.Row="0"
		        Grid.Column="1"
		        Command="{Binding OpenGroupDetailsCommand}"
		        IsVisible="{Binding IsGroupChat}"
		        HorizontalAlignment="Right"
		        VerticalAlignment="Top"
		        Margin="0,10,10,0">
			<Button.Content>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
					<Image Source="avares://ChatApp.Client/Assets/link-outline.png" Width="18" Height="18"/>
                    <TextBlock Text="群详情" VerticalAlignment="Center"/>
				</StackPanel>
			</Button.Content>
		</Button>

		<!-- 娑堟伅鍒楄〃鍖哄煙锛堝懡鍚嶅苟澧炲姞婊氬姩瀹氫綅閿氱偣锛?-->
		<ScrollViewer Name="MessagesScrollViewer" HorizontalScrollBarVisibility="Disabled" Grid.Row="1" Margin="10,10,10,10">
			<StackPanel>
				<ItemsControl Name="MessagesItemsControl" ItemsSource="{Binding Messages}"/>
				<!-- 婊氬姩瀹氫綅閿氱偣锛氭柊澧炴秷鎭椂 BringIntoView() 婊氬姩鍒板簳閮?-->
				<Border Name="EndAnchor" Height="1"/>
			</StackPanel>
		</ScrollViewer>
			
			 <!-- 杈撳叆鍖哄煙 -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto" Margin="20">
            <!-- 杈撳叆妗?-->
            <Border Grid.Column="0"
                    MinWidth="350"
                    Background="{DynamicResource EntryBackground}"
                    CornerRadius="5,0,0,5"
                    Padding="5">
                <Grid ColumnDefinitions="Auto, *">
                    <Button Grid.Column="0"
                            Command="{Binding DictateMessageCommand}"
                            Classes="IconButton"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0">
                        <Path Fill="{DynamicResource MicrophoneDefaultColor}"
                              Data="{DynamicResource MicrophoneGeometry}"
                              Margin="0,4,0,0"/>
                    </Button>
	                
	                <TextBox TextWrapping="Wrap"
	                         Grid.Column="1"
	                         Classes="ChatMessageComposer"
	                         Text="{Binding MessageContent}"
	                         BorderBrush="Transparent"
	                         Background="Transparent"
	                         VerticalContentAlignment="Center"
	                         Watermark="Type something..."/>
                </Grid>
            </Border>

            <!-- 闄勪欢鎸夐挳 -->
            <Border Grid.Column="1"
                    Background="{DynamicResource EntryBackground}"
                    Margin="2,0,0,0"
                    Padding="5">
                <Button Command="{Binding AttachImageCommand}"
                        Classes="IconButton"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                    <Path Fill="White"
                          Data="{DynamicResource ImageFileGeometry}"
                          Margin="0,4,0,0"
                          Stretch="Uniform"
                          Height="22"
                          VerticalAlignment="Center"/>
                    
                    
                </Button>
            </Border>

            <!-- 鍙戦€佹寜閽?-->
            <Border Grid.Column="2"
                    Background="{DynamicResource EntryBackground}"
                    Margin="2,0,0,0"
                    CornerRadius="0,5,5,0"
                    Padding="5">
                <Button Command="{Binding SendMessageCommand}"
                        Classes="IconButton"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0">
                    <Path Fill="{DynamicResource SystemAccentColor}"
                          Data="{DynamicResource SendMessageGeometry}"
                          Margin="0,4,0,0"
                          Stretch="Uniform"
                          Height="22"
                          VerticalAlignment="Center"/>
                </Button>
            </Border>
        </Grid>
    </Grid>
</UserControl>
