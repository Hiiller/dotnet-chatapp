<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChatApp.Client.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="400"
             d:DesignHeight="400"
             x:Class="ChatApp.Client.Views.AppearanceSettingsView"
             x:DataType="viewModels:AppearanceSettingsViewModel">
    <Border Background="#111B2A" Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="主题与外观"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#F5F7FB"/>

            <ListBox ItemsSource="{Binding Themes}"
                     SelectedItem="{Binding SelectedTheme}"
                     Background="Transparent"
                     BorderBrush="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A2742"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#F5F7FB"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="12"
                                           Foreground="#8EA0C5"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="关 闭"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    Padding="16 6"
                    Background="#2D8EFF"
                    Foreground="White"
                    BorderBrush="#2D8EFF"/>
        </StackPanel>
    </Border>
</UserControl>
