<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChatApp.Client.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="400"
             d:DesignHeight="400"
             x:Class="ChatApp.Client.Views.AppearanceSettingsView"
             x:DataType="viewModels:AppearanceSettingsViewModel">
    <Border Background="{DynamicResource ThemeBrush.SidebarBackground}" Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Themes &amp; Appearance"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>

            <ListBox ItemsSource="{Binding Themes}"
                     SelectedItem="{Binding SelectedTheme}"
                     Background="Transparent"
                     BorderBrush="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ThemeBrush.CardBackground}"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="12"
                                           Foreground="{DynamicResource ThemeBrush.MutedText}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    Padding="16 6"
                    Background="{DynamicResource ThemeBrush.Accent}"
                    Foreground="White"
                    BorderBrush="{DynamicResource ThemeBrush.Accent}"/>
        </StackPanel>
    </Border>
</UserControl>
