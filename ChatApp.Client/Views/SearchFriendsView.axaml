<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChatApp.Client.ViewModels"
             xmlns:dtos="clr-namespace:ChatApp.Client.DTOs;assembly=ChatApp.Client"
             xmlns:views="clr-namespace:ChatApp.Client.Views"
             mc:Ignorable="d"
             d:DesignWidth="720"
             d:DesignHeight="500"
             x:Class="ChatApp.Client.Views.SearchFriendsView"
             x:DataType="viewModels:SearchFriendsViewModel">
    <Grid Background="#0F1F33" Margin="24" RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Search friends and groups" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
            <TextBlock Text="Enter a username or group code to look up contacts"
                       Foreground="{DynamicResource ThemeBrush.MutedText}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,20" ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding SearchTerm}"
                     Watermark="Username or group code"
                     Height="44"
                     Background="{DynamicResource ThemeBrush.CardBackground}"
                     BorderBrush="{DynamicResource ThemeBrush.Border}"
                     CornerRadius="16"
                     Foreground="{DynamicResource ThemeBrush.PrimaryText}"
                     Padding="12"/>
            <Button Grid.Column="1"
                    Content="Search"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding CanStartSearch}"
                    Margin="12,0,0,0"
                    Padding="20,10"
                    Background="{DynamicResource ThemeBrush.Accent}"
                    Foreground="White"
                    CornerRadius="16"/>
        </Grid>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="16">
                <Border Background="#142037"
                        CornerRadius="12"
                        Padding="16"
                        IsVisible="{Binding GroupSearchResult, Converter={StaticResource NullToBooleanConverter}}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding GroupSearchResult.Name}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                            <TextBlock Text="{Binding GroupSearchResult.GroupCode, StringFormat='Code: {0}'}" Foreground="{DynamicResource ThemeBrush.MutedText}"/>
                            <TextBlock Text="{Binding GroupSearchResult.MemberCount, StringFormat='Members: {0}'}" Foreground="{DynamicResource ThemeBrush.MutedText}"/>
                            <TextBlock Text="{Binding GroupStatusMessage}" Foreground="#A7B4D6" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Request to join"
                                Command="{Binding RequestJoinGroupCommand}"
                                IsEnabled="{Binding CanRequestJoin}"
                                Background="{DynamicResource ThemeBrush.Accent}"
                                Foreground="White"
                                Padding="18,10"
                                Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <Border Background="#142037"
                        CornerRadius="12"
                        Padding="16"
                        IsVisible="{Binding GroupSearchResult, Converter={StaticResource NullToBooleanInverseConverter}}">
                    <TextBlock Text="{Binding GroupStatusMessage}"
                               Foreground="#A7B4D6"/>
                </Border>

                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="dtos:SearchUserResultDto">
                            <Border Background="{DynamicResource ThemeBrush.CardBackground}"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource ThemeBrush.Accent}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName, Converter={StaticResource StringToInitialsConverter}}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                                        <TextBlock Text="{Binding Username}" Foreground="{DynamicResource ThemeBrush.MutedText}"/>
                                        <TextBlock Text="{Binding PersonalCode, StringFormat='ID: {0}'}" Foreground="{DynamicResource ThemeBrush.MutedText}"/>
                                        <TextBlock Text="{Binding Bio}" Foreground="{DynamicResource ThemeBrush.MutedText}" TextWrapping="Wrap"
                                                   IsVisible="{Binding Bio, Converter={StaticResource NullToBooleanConverter}}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="Add"
                                            Command="{Binding ViewModel.SendFriendRequestCommand, RelativeSource={RelativeSource AncestorType=views:SearchFriendsView}}"
                                            CommandParameter="{Binding}"
                                            Padding="14,8"
                                            Background="{DynamicResource ThemeBrush.Accent}"
                                            Foreground="White"
                                            CornerRadius="12"
                                            BorderBrush="{DynamicResource ThemeBrush.Accent}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
