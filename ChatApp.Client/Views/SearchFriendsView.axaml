<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChatApp.Client.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="400"
             x:Class="ChatApp.Client.Views.SearchFriendsView"
             x:DataType="viewModels:SearchFriendsViewModel">
    <Grid Background="#0F1F33" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="搜索好友"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#F5F7FB"
                   Margin="0,0,0,20"/>

        <!-- Search Box -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <TextBox Grid.Column="0"
                     Text="{Binding SearchTerm}"
                     Watermark="输入用户昵称或用户名"
                     Height="40"
                     Background="#1A2742"
                     BorderBrush="#2A3A5A"
                     CornerRadius="16"
                     Foreground="#F5F7FB"
                     Padding="12"/>
            <Button Grid.Column="1"
                    Content="搜索"
                    Command="{Binding SearchCommand}"
                    Padding="18 10"
                    Margin="12,0,0,0"
                    Background="#2D8EFF"
                    Foreground="White"
                    FontSize="13"
                    CornerRadius="16"
                    BorderBrush="#2D8EFF"
                    IsEnabled="{Binding !IsSearching}"/>
        </Grid>

        <!-- Search Results -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding SearchResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A2742"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="24"
                                        Background="#2D8EFF"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName, Converter={StaticResource StringToInitialsConverter}}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#F5F7FB"/>
                                    <TextBlock Text="{Binding Username}"
                                               FontSize="12"
                                               Foreground="#8EA0C5"/>
                                    <TextBlock Text="{Binding Bio}"
                                               FontSize="12"
                                               Foreground="#64708F"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding Bio, Converter={StaticResource NullToBooleanConverter}}"/>
                                </StackPanel>
                                
                                <Button Grid.Column="2"
                                        Content="发送请求"
                                        Click="OnSendFriendRequestClick"
                                        DataContext="{Binding .}"
                                        Padding="14 8"
                                        Background="#2D8EFF"
                                        Foreground="White"
                                        FontSize="12"
                                        CornerRadius="12"
                                        BorderBrush="#2D8EFF"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

