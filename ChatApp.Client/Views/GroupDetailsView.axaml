<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChatApp.Client.ViewModels"
             xmlns:dtos="clr-namespace:ChatApp.Client.DTOs;assembly=ChatApp.Client"
             xmlns:views="clr-namespace:ChatApp.Client.Views"
             Background="{DynamicResource ChatBackground}"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="600"
             x:Class="ChatApp.Client.Views.GroupDetailsView"
             x:DataType="viewModels:GroupDetailsViewModel"
             x:CompileBindings="True">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#172033"/>
        <SolidColorBrush x:Key="MutedText" Color="#7F8DA1"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="{DynamicResource SystemAccentColor}" Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Command="{Binding BackCommand}" Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image Source="avares://ChatApp.Client/Assets/return.png" Width="18" Height="18"/>
                        <TextBlock Text="Back" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding GroupName}" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#E8EBFF" HorizontalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Command="{Binding RefreshCommand}"
                        Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Image Source="avares://ChatApp.Client/Assets/refresh.png" Width="16" Height="16"/>
                        <TextBlock Text="Refresh" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="16">
            <StackPanel Spacing="16">
                <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="16">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                        <StackPanel>
                            <TextBlock Text="Group Code" Foreground="{StaticResource MutedText}" FontSize="12"/>
                            <TextBlock Text="{Binding GroupCode}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Creator" Foreground="{StaticResource MutedText}" FontSize="12"/>
                            <TextBlock Text="{Binding CreatorName}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="My Role" Foreground="{StaticResource MutedText}" FontSize="12"/>
                            <TextBlock Text="{Binding CurrentUserRole}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Text="Description" Foreground="{StaticResource MutedText}" FontSize="12"/>
                            <TextBlock Text="{Binding GroupDescription}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,12,0,0">
                            <TextBlock Text="Members" Foreground="{StaticResource MutedText}" FontSize="12"/>
                            <TextBlock Text="{Binding MemberCount}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel>
                    <TextBlock Text="Members" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="dtos:GroupMemberDto">
                                <Border Background="{StaticResource CardBackground}" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#2D8EFF" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName, Converter={StaticResource StringToInitialsConverter}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Username}" Foreground="{StaticResource MutedText}" FontSize="12"/>
                                        <TextBlock Text="{Binding PersonalCode, StringFormat='ID: {0}'}"
                                                   Foreground="{StaticResource MutedText}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding Role}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        <Button Content="Remove"
                                                IsVisible="{Binding ViewModel.CanManageMembers, RelativeSource={RelativeSource AncestorType=views:GroupDetailsView}}"
                                                Command="{Binding ViewModel.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=views:GroupDetailsView}}"
                                                CommandParameter="{Binding}"
                                                Background="#E14E4E"
                                                BorderBrush="#E14E4E"
                                                Padding="10,4"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

                <StackPanel>
                    <TextBlock Text="Pending join requests"
                               FontSize="16"
                               FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding PendingRequests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="dtos:GroupJoinRequestDto">
                                <Border Background="{StaticResource CardBackground}" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RequesterDisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding RequesterUsername}" Foreground="{StaticResource MutedText}" FontSize="12"/>
                                            <TextBlock Text="{Binding RequesterPersonalCode, StringFormat='ID: {0}'}" Foreground="{StaticResource MutedText}" FontSize="12"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='Requested at: {0:yyyy-MM-dd HH:mm}'}" Foreground="{StaticResource MutedText}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Content="Reject"
                                                    Command="{Binding ViewModel.RejectRequestCommand, RelativeSource={RelativeSource AncestorType=views:GroupDetailsView}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#2A344D"
                                                    BorderBrush="#2A344D"/>
                                            <Button Content="Approve"
                                                    Command="{Binding ViewModel.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=views:GroupDetailsView}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#2D8EFF"
                                                    BorderBrush="#2D8EFF"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource CardBackground}" Padding="16">
            <Button Content="Leave Group"
                    Command="{Binding LeaveGroupCommand}"
                    Background="#E14E4E"
                    BorderBrush="#E14E4E"
                    Foreground="White"
                    HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
