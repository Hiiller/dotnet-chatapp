<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChatApp.Client.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="500"
             x:Class="ChatApp.Client.Views.RecoverPasswordView"
             x:DataType="viewModels:RecoverPasswordViewModel">
    <Border Background="#0F1928" Padding="32">
        <StackPanel Spacing="16">
            <TextBlock Text="找回密码"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#F5F7FB"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#8EA0C5"
                       TextWrapping="Wrap"/>

            <StackPanel Spacing="8">
                <TextBlock Text="用户�? Foreground="#F5F7FB"/>
                <TextBox Text="{Binding Username}"
                         Background="#1A2742"
                         BorderBrush="#2D8EFF"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="家在哪个城市�? Foreground="#F5F7FB"/>
                <TextBox Text="{Binding City}"
                         Background="#1A2742"
                         BorderBrush="#2D8EFF"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="最喜欢的动物？" Foreground="#F5F7FB"/>
                <TextBox Text="{Binding Animal}"
                         Background="#1A2742"
                         BorderBrush="#2D8EFF"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="父亲/母亲的名字？" Foreground="#F5F7FB"/>
                <TextBox Text="{Binding ParentName}"
                         Background="#1A2742"
                         BorderBrush="#2D8EFF"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                <Button Content="�?�?
                        Command="{Binding SubmitCommand}"
                        Padding="18 6"
                        Background="#2D8EFF"
                        Foreground="White"
                        BorderBrush="#2D8EFF"/>
                <Button Content="�?�?
                        Command="{Binding BackCommand}"
                        Padding="18 6"
                        Background="#2A344D"
                        Foreground="White"
                        BorderBrush="#2A344D"/>
            </StackPanel>

            <Border Background="#1A2742"
                    CornerRadius="12"
                    Padding="16"
                    IsVisible="{Binding RecoveredPassword, Converter={StaticResource NullToBooleanConverter}}">
                <StackPanel>
                    <TextBlock Text="当前密码"
                               Foreground="#8EA0C5"/>
                    <TextBlock Text="{Binding RecoveredPassword}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#F5F7FB"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
