<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChatApp.Client.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="500"
             x:Class="ChatApp.Client.Views.RecoverPasswordView"
             x:DataType="viewModels:RecoverPasswordViewModel">
    <Border Background="#0F1928" Padding="32">
        <StackPanel Spacing="16">
            <TextBlock Text="Recover Password"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource ThemeBrush.MutedText}"
                       TextWrapping="Wrap"/>

            <StackPanel Spacing="8">
                <TextBlock Text="Username" Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                <TextBox Text="{Binding Username}"
                         Background="{DynamicResource ThemeBrush.CardBackground}"
                         BorderBrush="{DynamicResource ThemeBrush.Accent}"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="What city is your home in?" Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                <TextBox Text="{Binding City}"
                         Background="{DynamicResource ThemeBrush.CardBackground}"
                         BorderBrush="{DynamicResource ThemeBrush.Accent}"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Favorite animal" Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                <TextBox Text="{Binding Animal}"
                         Background="{DynamicResource ThemeBrush.CardBackground}"
                         BorderBrush="{DynamicResource ThemeBrush.Accent}"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Father/Mother name" Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                <TextBox Text="{Binding ParentName}"
                         Background="{DynamicResource ThemeBrush.CardBackground}"
                         BorderBrush="{DynamicResource ThemeBrush.Accent}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Submit"
                        Command="{Binding SubmitCommand}"
                        Padding="18 6"
                        Background="{DynamicResource ThemeBrush.Accent}"
                        Foreground="White"
                        BorderBrush="{DynamicResource ThemeBrush.Accent}"/>
                <Button Content="Back"
                        Command="{Binding BackCommand}"
                        Padding="18 6"
                        Background="{DynamicResource SecondaryButtonBackground}"
                        Foreground="White"
                        BorderBrush="{DynamicResource SecondaryButtonBackground}"/>
            </StackPanel>

            <Border Background="{DynamicResource ThemeBrush.CardBackground}"
                    CornerRadius="12"
                    Padding="16"
                    IsVisible="{Binding RecoveredPassword, Converter={StaticResource NullToBooleanConverter}}">
                <StackPanel>
                    <TextBlock Text="Current password"
                               Foreground="{DynamicResource ThemeBrush.MutedText}"/>
                    <TextBlock Text="{Binding RecoveredPassword}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
