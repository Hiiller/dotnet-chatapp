<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChatApp.Client.ViewModels"
             xmlns:dtos="clr-namespace:ChatApp.Client.DTOs;assembly=ChatApp.Client"
             xmlns:views="clr-namespace:ChatApp.Client.Views"
             xmlns:local="using:ChatApp.Client"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="720"
             x:Class="ChatApp.Client.Views.ChatList"
             x:DataType="viewModels:ChatListModel"
             x:Name="ChatListRoot">
    <UserControl.Resources>
        <local:ViewLocator x:Key="ViewLocatorTemplate"/>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ThemeBrush.WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel: contacts, groups, settings -->
        <Border Grid.Column="0"
                Background="{DynamicResource ThemeBrush.SidebarBackground}"
                Padding="24">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Profile summary -->
                <StackPanel Spacing="20">
                    <Border Background="{DynamicResource ThemeBrush.CardBackground}"
                            CornerRadius="20"
                            Padding="20">
                        <Grid ColumnDefinitions="Auto,*">
                            <Button Command="{Binding OpenProfileCommand}"
                                    Background="Transparent"
                                    BorderBrush="Transparent">
                                <Border Width="72"
                                        Height="72"
                                        CornerRadius="36"
                                        Background="{DynamicResource ThemeBrush.Accent}"
                                        ClipToBounds="True">
                                    <Grid>
                                        <!-- When no avatar exists, show initials so the slot is never empty -->
                                        <TextBlock Text="{Binding UserInitials}"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding UserAvatar, Converter={StaticResource NullToBooleanInverseConverter}}"/>
                                        <!-- Display the actual avatar image when present -->
                                        <Image Source="{Binding UserAvatar}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding UserAvatar, Converter={StaticResource NullToBooleanConverter}}"/>
                                    </Grid>
                                </Border>
                            </Button>

                            <StackPanel Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserDisplayName}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ThemeBrush.MutedText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Spacing="12">
                        <Button Content="Add Friend"
                                Padding="14 10"
                                Background="{DynamicResource ThemeBrush.Accent}"
                                Foreground="White"
                                FontSize="13"
                                CornerRadius="16"
                                BorderBrush="{DynamicResource ThemeBrush.Accent}"
                                Command="{Binding AddCommand}"/>
                        <Button Content="Create Group"
                                Padding="14 10"
                                Background="{DynamicResource ThemeBrush.CardBackground}"
                                Foreground="{DynamicResource ThemeBrush.PrimaryText}"
                                FontSize="13"
                                CornerRadius="16"
                                BorderBrush="{DynamicResource ThemeBrush.Border}"
                                Command="{Binding CreateGroupCommand}"/>
                        <Button Content="Refresh"
                                Padding="14 10"
                                Background="{DynamicResource ThemeBrush.CardBackground}"
                                Foreground="{DynamicResource ThemeBrush.PrimaryText}"
                                FontSize="13"
                                CornerRadius="16"
                                BorderBrush="{DynamicResource ThemeBrush.Border}"
                                Command="{Binding RefreshRightPanelCommand}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tab content -->
                <TabControl Grid.Row="1"
                            Margin="0,24,0,24"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            SelectedIndex="0">
                    <TabItem Header="Friends">
                        <Grid RowDefinitions="Auto,*">
                            <Border Background="{DynamicResource ThemeBrush.CardBackground}"
                                    CornerRadius="16"
                                    Padding="12"
                                    Margin="0,0,0,16">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Watermark="Search friends or status"
                                         Background="Transparent"
                                         BorderBrush="Transparent"
                                         Foreground="{DynamicResource ThemeBrush.PrimaryText}"
                                         FontSize="14"/>
                            </Border>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding FilteredContacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding HasPendingRequest, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='ThemeBrush.Warning:ThemeBrush.CardBackground'}"
                                                    CornerRadius="18"
                                                    Padding="16"
                                                    Margin="0,0,0,14">
                                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                    <Button Command="{Binding ProfileCommand}"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent">
                                                        <Grid Width="56" Height="56">
                                                            <Border CornerRadius="28"
                                                                    Background="{DynamicResource ThemeBrush.Accent}">
                                                                <TextBlock Text="{Binding AvatarInitials}"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Ellipse Width="12" Height="12"
                                                                     Fill="{DynamicResource ThemeBrush.Success}"
                                                                     Stroke="{DynamicResource ThemeBrush.SidebarBackground}"
                                                                     StrokeThickness="2"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Bottom"
                                                                     IsVisible="{Binding IsOnline}"/>
                                                        </Grid>
                                                    </Button>

                                                    <StackPanel Grid.Column="1" Spacing="6" Margin="16,0,0,0">
                                                        <TextBlock Text="{Binding Username}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                                                        <TextBlock Text="{Binding StatusMessage}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ThemeBrush.MutedText}"/>
                                                        <TextBlock Text="{Binding LastMessagePreview}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ThemeBrush.MutedText}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="220"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                Spacing="8">
                                                        <!-- Friend request buttons (when HasPendingRequest is true) -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    IsVisible="{Binding HasPendingRequest}">
                                                            <Button Content="Confirm"
                                                                    Command="{Binding AcceptFriendRequestCommand}"
                                                                    CommandParameter="{Binding .}"
                                                                    Padding="14 6"
                                                                    Background="{DynamicResource ThemeBrush.Success}"
                                                                    Foreground="White"
                                                                    FontSize="12"
                                                                    CornerRadius="14"
                                                                    BorderBrush="{DynamicResource ThemeBrush.Success}"/>
                                                            <Button Content="Cancel"
                                                                    Command="{Binding RejectFriendRequestCommand}"
                                                                    CommandParameter="{Binding .}"
                                                                    Padding="14 6"
                                                                    Background="{DynamicResource ThemeBrush.Danger}"
                                                                    Foreground="White"
                                                                    FontSize="12"
                                                                    CornerRadius="14"
                                                                    BorderBrush="{DynamicResource ThemeBrush.Danger}"/>
                                                        </StackPanel>
                                                        
                                                        <!-- Normal buttons (when HasPendingRequest is false) -->
                                                        <StackPanel Orientation="Vertical"
                                                                    Spacing="8"
                                                                    IsVisible="{Binding HasPendingRequest, Converter={StaticResource BooleanInverseConverter}}">
                                                            <Button Content="Chat"
                                                                    Command="{Binding ButtonCommand}"
                                                                    CommandParameter="{Binding .}"
                                                                    Padding="14 6"
                                                                    Background="{DynamicResource ThemeBrush.Accent}"
                                                                    Foreground="White"
                                                                    FontSize="12"
                                                                    CornerRadius="14"
                                                                    BorderBrush="{DynamicResource ThemeBrush.Accent}"/>
                                                            <Button Content="Profile"
                                                                    Command="{Binding ProfileCommand}"
                                                                    Padding="14 6"
                                                                    Background="{DynamicResource ThemeBrush.CardBackground}"
                                                                    Foreground="{DynamicResource ThemeBrush.PrimaryText}"
                                                                    FontSize="12"
                                                                    CornerRadius="14"
                                                                    BorderBrush="{DynamicResource ThemeBrush.Border}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Groups">
                        <ScrollViewer>
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6"
                                            IsVisible="{Binding HasPendingGroupRequests}">
                                    <TextBlock Text="Pending group join requests"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                                    <ItemsControl ItemsSource="{Binding PendingGroupRequests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="dtos:GroupJoinRequestNotificationDto">
                                                <Border Background="{DynamicResource ThemeBrush.CardBackground}"
                                                        CornerRadius="16"
                                                        Padding="16"
                                                        Margin="0,0,0,12">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding RequesterDisplayName}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                                                            <TextBlock Text="{Binding GroupName, StringFormat='Target group: {0}'}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource ThemeBrush.MutedText}"/>
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat='Requested at: {0:MM-dd HH:mm}'}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource ThemeBrush.MutedText}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    VerticalAlignment="Center">
                                                            <Button Content="Reject"
                                                                    Command="{Binding #ChatListRoot.ViewModel.RejectGroupJoinRequestCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{DynamicResource SecondaryButtonBackground}"
                                                                    BorderBrush="{DynamicResource SecondaryButtonBorder}"
                                                                    Foreground="White"
                                                                    Padding="14 6"/>
                                                            <Button Content="Approve"
                                                                    Command="{Binding #ChatListRoot.ViewModel.ApproveGroupJoinRequestCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{DynamicResource ThemeBrush.Accent}"
                                                                    BorderBrush="{DynamicResource ThemeBrush.Accent}"
                                                                    Foreground="White"
                                                                    Padding="14 6"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThemeBrush.CardBackground}"
                                                    CornerRadius="18"
                                                    Padding="18"
                                                    Margin="0,0,0,14">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="6">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="16"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                                                            <Border Background="{DynamicResource ThemeBrush.Accent}"
                                                                    CornerRadius="10"
                                                                    Padding="8 2"
                                                                    IsVisible="{Binding IsPinned}">
                                                                <TextBlock Text="Pinned"
                                                                           FontSize="11"
                                                                           Foreground="White"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource ThemeBrush.MutedText}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding MemberCount, StringFormat='Members: {0} people'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ThemeBrush.MutedText}"/>
                                                        <TextBlock Text="{Binding PendingJoinRequestSummary}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource ThemeBrush.Warning}"
                                                                   IsVisible="{Binding HasPendingJoinRequests}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Open"
                                                            Command="{Binding OpenCommand}"
                                                            Padding="16 8"
                                                            Background="{DynamicResource ThemeBrush.Accent}"
                                                            Foreground="White"
                                                            FontSize="12"
                                                            CornerRadius="14"
                                                            BorderBrush="{DynamicResource ThemeBrush.Accent}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Settings">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding SettingsOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ThemeBrush.CardBackground}"
                                                CornerRadius="18"
                                                Padding="18"
                                                Margin="0,0,0,14">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ThemeBrush.PrimaryText}"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource ThemeBrush.MutedText}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Manage"
                                                        Command="{Binding Command}"
                                                        Padding="14 6"
                                                        Background="{DynamicResource ThemeBrush.CardBackground}"
                                                        Foreground="{DynamicResource ThemeBrush.PrimaryText}"
                                                        FontSize="12"
                                                        CornerRadius="14"
                                                        BorderBrush="{DynamicResource ThemeBrush.Border}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Add new friend input -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="12">
                    <TextBox Text="{Binding NewContactName, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="Enter friend or group code"
                             Height="40"
                             Background="{DynamicResource ThemeBrush.CardBackground}"
                             BorderBrush="{DynamicResource ThemeBrush.Border}"
                             CornerRadius="16"
                             Foreground="{DynamicResource ThemeBrush.PrimaryText}"
                             Padding="12"/>
                    <Button Content="Add"
                            Command="{Binding AddCommand}"
                            Padding="18 10"
                            Background="{DynamicResource ThemeBrush.Accent}"
                            Foreground="White"
                            FontSize="13"
                            CornerRadius="16"
                            BorderBrush="{DynamicResource ThemeBrush.Accent}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right panel: embedded chat/search or default overview -->
        <Grid Grid.Column="1"
              Margin="24"
              Background="{DynamicResource ThemeBrush.SidebarBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Popout button (only visible when in embedded chat mode) -->
            <Button Grid.Row="0"
                    Content="Open pop-out window"
                    Command="{Binding PopoutChatCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,12"
                    Padding="12 8"
                    Background="{DynamicResource ThemeBrush.CardBackground}"
                    Foreground="{DynamicResource ThemeBrush.PrimaryText}"
                    FontSize="12"
                    CornerRadius="12"
                    BorderBrush="{DynamicResource ThemeBrush.Border}"
                    IsVisible="{Binding IsEmbeddedChatMode}"/>
            
            <!-- Content area -->
            <Grid Grid.Row="1">
                <!-- Embedded content (chat or search) -->
                <ContentControl x:Name="RightPanelContentControl"
                               ContentTemplate="{StaticResource ViewLocatorTemplate}"
                               IsVisible="False"/>
                
                <!-- Default content when RightPanelContent is null -->
                <StackPanel x:Name="DefaultContentPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="20"
                            Width="360"
                            IsVisible="True">
                    <Image Source="avares://ChatApp.Client/Assets/appIcon.png"
                           Width="96"
                           Height="96"
                           Opacity="0.9"/>
                    <TextBlock Text="Select a friend or group to start chatting"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeBrush.PrimaryText}"
                               TextAlignment="Center"/>
                    <TextBlock Text="Use the left list to search contacts, manage groups, and adjust chat settings"
                               FontSize="13"
                               Foreground="{DynamicResource ThemeBrush.MutedText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center">
                        <Border Background="{DynamicResource ThemeBrush.CardBackground}"
                                CornerRadius="14"
                                Padding="14 8">
                            <TextBlock Text="Live presence indicator"
                                       Foreground="{DynamicResource ThemeBrush.PrimaryText}"
                                       FontSize="12"/>
                        </Border>
                        <Border Background="{DynamicResource ThemeBrush.CardBackground}"
                                CornerRadius="14"
                                Padding="14 8">
                            <TextBlock Text="Unread message highlight"
                                       Foreground="{DynamicResource ThemeBrush.PrimaryText}"
                                       FontSize="12"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>








