<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ChatApp.Client.ViewModels"
        x:Class="ChatApp.Client.Views.SecurityDialog"
        x:DataType="viewModels:SecurityViewModel"
        Title="Account privacy"
        Width="350" Height="240"
        CanResize="False">
    <Border Padding="24">
        <StackPanel Spacing="12">
            <TextBlock Text="Security options" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Feature under construction" Foreground="#8EA0C5"/>
            <Button Content="Close" Command="{Binding CloseCommand}" HorizontalAlignment="Right" Padding="12,6"/>
        </StackPanel>
    </Border>
</Window>
