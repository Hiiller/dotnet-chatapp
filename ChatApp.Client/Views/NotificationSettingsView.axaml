<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ChatApp.Client.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="400"
             d:DesignHeight="400"
             x:Class="ChatApp.Client.Views.NotificationSettingsView"
             x:DataType="viewModels:NotificationSettingsViewModel">
    <Border Background="#111B2A" Padding="24">
        <StackPanel Spacing="20">
            <TextBlock Text="Notification Settings"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#F5F7FB"/>

            <Border Background="#1A2742" CornerRadius="14" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Mute everything"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#F5F7FB"/>
                    <TextBlock Text="Disable all message notifications"
                               FontSize="12"
                               Foreground="#8EA0C5"/>
                    <ToggleSwitch IsChecked="{Binding MuteAll}"
                                  Content="Mute all messages"/>
                </StackPanel>
            </Border>

            <Border Background="#1A2742" CornerRadius="14" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sound alerts"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#F5F7FB"/>
                    <TextBlock Text="Play a chime when a new message arrives"
                               FontSize="12"
                               Foreground="#8EA0C5"/>
                    <ToggleSwitch IsChecked="{Binding EnableSound}"
                                  Content="Enable sound"/>
                </StackPanel>
            </Border>

            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    Padding="16 8"
                    Background="#2D8EFF"
                    Foreground="White"
                    BorderBrush="#2D8EFF"/>
        </StackPanel>
    </Border>
</UserControl>
